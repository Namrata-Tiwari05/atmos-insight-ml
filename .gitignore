# ==========================================
# Atmos Insight — Production Git Ignore Policy
# ==========================================

# Environment & Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build Outputs
dist/
build/
coverage/

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Files
logs/
*.log
tmp/
temp/
.cache/

# ML Experiment Logs
training_logs/
wandb/
mlruns/
tensorboard/

# IMPORTANT: NEVER IGNORE ML MODELS OR STATIC ASSETS
!models/**/*.pkl
!models/**/*.json
!backend/app/static/**
!frontend/public/**
!artifacts/shap/**
